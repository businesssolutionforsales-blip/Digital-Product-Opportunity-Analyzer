    "motion": "^11.15.0",
    "tsx": "^4.19.2",
    "esbuild": "^0.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/express": "^4.17.21",
    "@types/react": "^19.0.2",
