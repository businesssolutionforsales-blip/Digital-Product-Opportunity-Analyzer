{
  "name": "digital-product-opportunity-analyzer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && npm run build:api && esbuild server.ts --bundle --platform=node --format=esm --packages=external --outfile=server-build/server.js",
    "build:api": "esbuild src/server/leadsFunctionEntry.ts --bundle --platform=node --format=esm --external:@google/genai --external:dotenv --banner:js=\"// @ts-nocheck\" --outfile=api/leads.ts",
    "start": "node server-build/server.js --prod",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "dependencies": {
    "@google/genai": "^2.24.0",
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "lucide-react": "^0.469.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^5.4.11",
    "express": "^4.21.2",
    "dotenv": "^16.4.5",
    "motion": "^11.15.0",
    "tsx": "^4.19.2",
    "esbuild": "^0.25.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
